# Copy to .env and adjust. Every value has a safe default.
LLM_BACKEND=ollama            # ollama | anthropic | mock | cloud. Use mock to run without any model
# Claude API (LLM_BACKEND=anthropic). Never commit a real key; .env is git-ignored.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low        # low | medium | high | xhigh | max
MOCK_LLM=false
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434  # use http://localhost:11434 when Ollama runs outside Docker
# Ollama Cloud instead of a local model: OLLAMA_BASE_URL=https://ollama.com, LLM_MODEL=gemma4:31b (see https://ollama.com/api/tags)
# OLLAMA_API_KEY=             # Ollama Cloud key; never commit it
LLM_TIMEOUT_SECONDS=60        # raise (e.g. 180) when the model runs on CPU only
# LLM_THINK=false             # reasoning models such as qwen3: skip the thinking trace (much faster)
API_TIMEOUT_SECONDS=90        # how long the Streamlit UI waits for /ask
EMBEDDING_BACKEND=auto        # auto | sentence-transformers | hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_BACKEND=lexical      # lexical | cross-encoder | none
CHUNKING_STRATEGY=structure   # structure | fixed
TOP_K=8
ADMIN_TOKEN=change-me         # required for /ingest, /admin/load and reading other students' audit records
AUDIT_SALT=change-me-in-production
LOG_LEVEL=INFO
# AS_OF_DATE_OVERRIDE=2026-10-06   # reproducible demos only
